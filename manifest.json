{
  "manifest_version": 3,
  "name": "Weblio keybind",
  "version": "2.0.0",
  "description": "Enter to listen pronounciation. Start input from anywhere.",
  "host_permissions": [
    "https://ejje.weblio.jp/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ejje.weblio.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
